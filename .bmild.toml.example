user_name = "Developer"     # persona will address user by this name
plan_folder = "plans/"      # desired location relative to project root to store context memory and planning documents
slice_target = 172000       # peak live context budget for one implementation Slice
tokenizer_base = 15000      # fixed overhead: system prompt, user prompt, mandatory context
tokenizer_multiplier = 1.25 # residual safety margin applied to the variable working set
commit = 0                  # 0: off; 1: message + eligible local commit; 2: message only
# format = "conventional-commits" # omit to infer local history, then fall back here
branch = "current"         # current | initiative
gap_resolution = "auto"    # auto (default) | ask-consult | handoff-only

# Claude Code and Codex tier overrides are optional. Design/planning fall back
# to release-pinned highest-capability pairs; implementation/reviewer inherit.
[intelligence.claude_code.design]
model = "opus"
effort = "max"

[intelligence.claude_code.planning]
model = "opus"
effort = "max"

[intelligence.codex.design]
model = "gpt-5.6-sol"
effort = "ultra"

[intelligence.codex.planning]
model = "gpt-5.6-sol"
effort = "ultra"

# Optional inherited-tier overrides:
# [intelligence.codex.implementation]
# model = "gpt-5.6-terra"
# effort = "high"
#
# [intelligence.codex.reviewer]
# model = "gpt-5.6-terra"
# effort = "high"

# OpenCode consults always inherit the user's harness-wide model and variant.

user_name = "Developer"     # persona will address user by this name
plan_folder = "plans/"      # desired location relative to project root to store context memory and planning documents
commit = 0                  # 0: off; 1: message + eligible local commit; 2: message only
# format = "conventional-commits" # omit to infer local history, then fall back here
branch = "current"         # current | initiative
gap_resolution = "auto"    # auto (default) | ask-consult | handoff-only

# All unspecified model/effort tiers inherit the user-selected harness session.
# Optional native owner-dispatch overrides (use a supported pair in your harness):
# [intelligence.claude_code.design]
# model = "<native model>"
# effort = "<native effort>"
# [intelligence.claude_code.planning]
# model = "<native model>"
# effort = "<native effort>"
# [intelligence.codex.design]
# model = "<native model>"
# effort = "<native effort>"
# [intelligence.codex.planning]
# model = "<native model>"
# effort = "<native effort>"
# The implementation and reviewer tiers accept the same optional fields.
# Explicit pairs are honored; rejected pairs do not silently fall back.
# OpenCode always inherits the user's harness model and variant.
# Retired slice_target/tokenizer_base/tokenizer_multiplier settings are inert.
